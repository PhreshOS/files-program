{
    "name": "files-program",
    "private": true,
    "version": "0.1.0",
    "description": "Browse and manage the files on your machine.",
    "type": "module",
    "scripts": {
        "check": "tsc --noEmit -p .",
        "build": "vite-node scripts/build.ts",
